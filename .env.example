# KryptoDB — Environment Variables
# Copy this file to .env and fill in your production secrets.
# Never commit a .env with real secrets.

# ── Database connections ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
REDIS_URL=redis://localhost:6379/0

# ── KryptoDB daemon ─────────────────────────────────────────────────────────
# Set to "production" to enable strict secret validation at startup
KRYPTODB_ENV=development

# 64-hex-character server master key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
KRYPTODB_MASTER_KEY=

# Admin API key — generated at first startup or set explicitly
# Required in production mode
KRYPTODB_ADMIN_API_KEY=

# ── Customer-managed scope keys ────────────────────────────────────────────
# Option A: Inline JSON (development / small deployments)
# KRYPTODB_SCOPE_KEYS_JSON={"research":{"key_id":"research:v1","key":"<base64-32-bytes>"}}

# Option B: Path to a secret JSON file (recommended for production)
# KRYPTODB_SCOPE_KEYS_FILE=/run/secrets/kryptodb-scope-keys.json

# ── Docker distribution (kryptodb-compose.yml) ─────────────────────────────
# Pinned image version tag — leave as "latest" for most recent stable release
KRYPTODB_VERSION=latest
